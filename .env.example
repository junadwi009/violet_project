# App
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_CLIENT_URL=http://localhost:5173

# Auth placeholders for later phases
VIOLET_API_TOKEN=change_me_local_dev
JWT_SECRET=change_me

# LLM
# mock is the safe default. Use ollama/openai_compatible only after configuring a local or cloud endpoint.
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=120
LLM_API_KEY=

# STT
STT_PROVIDER=mock
STT_BASE_URL=http://localhost:9090
STT_MODEL=mock
STT_LANGUAGE=id

# TTS
TTS_PROVIDER=mock
TTS_BASE_URL=http://localhost:8020
TTS_VOICE=default
TTS_LANGUAGE=id

# Memory
DATABASE_URL=sqlite:///./data/violet.db
VECTOR_PROVIDER=none

# RAG (Track 2). none = no retrieval, chat behaves as pre-RAG. Track 2 adds real providers.
RAG_PROVIDER=none
MEMORY_AUTO_SAVE=false
MEMORY_REQUIRE_APPROVAL=true

# Safety
ALLOW_SHELL_TOOLS=false
ALLOW_EMAIL_TOOLS=false
ALLOW_FILE_DELETE=false
REQUIRE_CONFIRMATION_FOR_RISKY_TOOLS=true

# Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# Web client
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AVATAR_VRM_PATH=/avatar/violet.vrm
