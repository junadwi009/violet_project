# App
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_CLIENT_URL=http://localhost:5173

# Auth placeholders for later phases
VIOLET_API_TOKEN=change_me_local_dev
JWT_SECRET=change_me

# LLM
# mock is the safe default. Use ollama/openai_compatible only after configuring a local or cloud endpoint.
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=120
LLM_API_KEY=

# Multi-layer routing (Phase 2). single = one model; cascade = persona layer delegates
# heavy technical sub-tasks to a technical layer on demand.
LLM_ROUTER=single
# OpenRouter (OpenAI-compatible). Put the real key only in .env (git-ignored), never here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Persona (front) layer — steerable/private-facing. Point at OpenRouter now, a local Ollama later.
PERSONA_BASE_URL=https://openrouter.ai/api/v1
PERSONA_MODEL=nousresearch/hermes-4-70b
PERSONA_API_KEY=
# Technical layer — invoked on demand for calc/code/reasoning.
TECHNICAL_BASE_URL=https://openrouter.ai/api/v1
TECHNICAL_MODEL=deepseek/deepseek-chat-v3.1
TECHNICAL_API_KEY=

# Skills / artifacts (Phase 3). Coding model that generates charts + HTML dashboards.
# Skills activate when an artifact key is available (defaults to OPENROUTER_API_KEY).
ARTIFACT_BASE_URL=https://openrouter.ai/api/v1
ARTIFACT_MODEL=qwen/qwen3-coder
ARTIFACT_API_KEY=
# SKILLS_CONFIG_DIR=./configs/skills   # override the skill definitions directory

# File upload + OCR (Phase 3c). Vision model reads images/scanned pages (via OPENROUTER_API_KEY).
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen3-vl-32b-instruct
VISION_API_KEY=
MAX_UPLOAD_MB=15

# Specialized sub-agents (Phase 3e). Each agent (configs/agents/*.json) has its own model.
# Agents run via OPENROUTER_API_KEY by default; override the base/key here if needed.
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=
# AGENTS_CONFIG_DIR=./configs/agents   # override the agent definitions directory
# Model for imported Anthropic SKILL.md agents (drop them in configs/agents/imported/<name>/SKILL.md).
AGENT_DEFAULT_MODEL=nousresearch/hermes-4-70b

# STT
STT_PROVIDER=mock
STT_BASE_URL=http://localhost:9090
STT_MODEL=mock
STT_LANGUAGE=id

# TTS
TTS_PROVIDER=mock
TTS_BASE_URL=http://localhost:8020
TTS_VOICE=default
TTS_LANGUAGE=id

# Memory
DATABASE_URL=sqlite:///./data/violet.db
VECTOR_PROVIDER=none

# Approved-memory storage. files = markdown files in MEMORY_DIR (default, directory-managed,
# VPS/Drive-syncable). sqlite = original memories table. Candidates always stay in SQLite.
MEMORY_BACKEND=files
# Point this at a local folder, a VPS mount, or a Google-Drive-synced folder to manage memory there.
MEMORY_DIR=./memory

# RAG (Track 2). none = no retrieval, chat behaves as pre-RAG. vector = local knowledge base.
RAG_PROVIDER=none

# Knowledge base (Phase A). Embeddings default to a deterministic mock (zero setup);
# set EMBED_PROVIDER=ollama + run Ollama for real semantic search.
KNOWLEDGE_DIR=./knowledge
EMBED_PROVIDER=mock
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text

# Knowledge base — Google Drive connector (Phase C). Requires: pip install -e ".[drive]"
# and RAG_PROVIDER=vector. Set up an OAuth Desktop client in Google Cloud, download its
# JSON, and share the target Drive folder if using a Shared Drive.
KNOWLEDGE_SOURCES=local
GDRIVE_FOLDER_ID=
GDRIVE_SHARED_DRIVE_ID=
GOOGLE_OAUTH_CLIENT_SECRETS=
GDRIVE_TOKEN_PATH=
GDRIVE_EXPORT_DOC=text/markdown
MEMORY_AUTO_SAVE=false
MEMORY_REQUIRE_APPROVAL=true

# Safety
ALLOW_SHELL_TOOLS=false
ALLOW_EMAIL_TOOLS=false
ALLOW_FILE_DELETE=false
REQUIRE_CONFIRMATION_FOR_RISKY_TOOLS=true

# Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# Web client
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AVATAR_VRM_PATH=/avatar/violet.vrm
